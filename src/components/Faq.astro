---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
  title?: string;
}

const { items, title = "Perguntas que ajudam a começar" } = Astro.props;
---

<section class="faq section-shell">
  <div class="section-heading">
    <p class="meta">Perguntas / respostas</p>
    <h2>{title}</h2>
  </div>
  <div class="faq__list">
    {items.map((item, index) => (
      <details>
        <summary>
          <span class="meta">{String(index + 1).padStart(2, "0")}</span>
          <span>{item.question}</span>
          <span class="faq__mark" aria-hidden="true">+</span>
        </summary>
        <div class="faq__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
