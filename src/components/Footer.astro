---
import { navigation, siteName } from "../data/site";
import { publicConfig, whatsappHref } from "../config";

const year = new Date().getFullYear();
const whatsapp = whatsappHref(
  "Olá, Mariana! Encontrei o site da Peixeaomar e gostaria de conversar sobre um projeto."
);
---

<footer class="site-footer">
  <div class="site-footer__statement">
    <p class="meta">Peixeaomar / Rio de Janeiro</p>
    <p class="display display--small">Criar sem apagar as marcas.</p>
  </div>

  <div class="site-footer__links">
    <nav aria-label="Rodapé">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/privacidade/">Privacidade</a></li>
      </ul>
    </nav>
  </div>

  <div class="site-footer__contact">
    <p class="meta">Começar uma conversa</p>
    {whatsapp && (
      <a href={whatsapp} target="_blank" rel="noreferrer">
        WhatsApp <span aria-hidden="true">↗</span>
      </a>
    )}
    {publicConfig.contactEmail && (
      <a href={`mailto:${publicConfig.contactEmail}`}>
        {publicConfig.contactEmail}
      </a>
    )}
    {publicConfig.alboomUrl && (
      <a href={publicConfig.alboomUrl} target="_blank" rel="noreferrer">
        Área de clientes no Alboom <span aria-hidden="true">↗</span>
      </a>
    )}
    {!whatsapp && !publicConfig.contactEmail && (
      <a href="/contato/">Formulário de contato</a>
    )}
  </div>

  <div class="site-footer__base">
    <span>© {year} {siteName}</span>
    <span>Fotografia / arte / educação / cultura</span>
  </div>
</footer>
