---
import { depoimentos } from "../data/depoimentos";
import { publicConfig } from "../config";
---

<section class="testimonials section-shell section-shell--dark">
  <div class="section-heading">
    <p class="meta">Quem já trabalhou comigo</p>
    <h2>Palavra de quem viveu o processo.</h2>
  </div>
  <div class="testimonials__grid">
    {depoimentos.map((item, index) => (
      <blockquote
        class="testimonial-card"
        data-reveal
        style={`--reveal-delay: ${index * 80}ms`}
      >
        <p>“{item.text}”</p>
        <footer>
          <strong>{item.author}</strong>
          <span class="meta">{item.context}</span>
        </footer>
      </blockquote>
    ))}
  </div>
  {publicConfig.googleReviewsUrl && (
    <a class="text-link" href={publicConfig.googleReviewsUrl} target="_blank" rel="noreferrer">
      Ver todas as avaliações no Google <span aria-hidden="true">↗</span>
    </a>
  )}
</section>
