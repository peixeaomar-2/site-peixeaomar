---
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  tone?: "night" | "magenta" | "plum";
}

const {
  eyebrow = "Tem um projeto em movimento?",
  title = "Vamos construir o próximo passo.",
  text = "Conte o contexto, a cidade, a data e o que você imagina. A conversa começa sem compromisso.",
  tone = "magenta"
} = Astro.props;
---

<section class:list={["contact-cta", `contact-cta--${tone}`]}>
  <div class="contact-cta__copy">
    <p class="meta">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="button button--salt" href="/contato/">
    Pedir um orçamento <span aria-hidden="true">→</span>
  </a>
</section>
