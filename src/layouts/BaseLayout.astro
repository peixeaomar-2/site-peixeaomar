---
import { ClientRouter } from "astro:transitions";
import HeadMeta from "../components/HeadMeta.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { publicConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
const jsonLdItems = Array.isArray(props.jsonLd)
  ? props.jsonLd
  : props.jsonLd
    ? [props.jsonLd]
    : [];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#10223D" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <ClientRouter />
    <HeadMeta {...props} />
    {jsonLdItems.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item)}
        is:inline
      />
    ))}
    {publicConfig.analyticsId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${publicConfig.analyticsId}`}
          is:inline
        />
        <script
          is:inline
          define:vars={{ analyticsId: publicConfig.analyticsId }}
        >
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", analyticsId, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {publicConfig.previewMode && (
      <div class="preview-bar" role="status">
        <span>Prévia em construção</span>
        <span>fotografias e contatos ainda serão revisados</span>
      </div>
    )}
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      const revealAll = () => {
        const elements = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          elements.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        elements.forEach((el) => observer.observe(el));
      };

      revealAll();
      document.addEventListener("astro:page-load", revealAll);
    </script>
  </body>
</html>
