---
import BaseLayout from "./BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Faq from "../components/Faq.astro";
import type { ServicePage } from "../data/site";
import { posts } from "../data/site";
import { publicConfig } from "../config";

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const related = posts.find((post) => post.slug === service.relatedArticle);
const canonicalPath = `/${service.slug}/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    description: service.seoDescription,
    provider: {
      "@type": "ProfessionalService",
      name: "Peixeaomar",
      url: publicConfig.siteUrl,
      areaServed: {
        "@type": "City",
        name: "Rio de Janeiro"
      }
    },
    areaServed: "Rio de Janeiro, RJ",
    url: new URL(canonicalPath, publicConfig.siteUrl).toString()
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: service.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: publicConfig.siteUrl
      },
      {
        "@type": "ListItem",
        position: 2,
        name: service.navLabel,
        item: new URL(canonicalPath, publicConfig.siteUrl).toString()
      }
    ]
  }
];
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <article class="service-page">
    <header class="service-hero">
      <div class="service-hero__copy">
        <p class="meta">{service.number} / {service.eyebrow}</p>
        <h1>{service.title}</h1>
        <p class="service-hero__summary">{service.summary}</p>
        <div class="tag-list" aria-label="Temas">
          {service.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
      <figure class="service-hero__image">
        <img
          src={service.image}
          alt={service.imageAlt}
          width="1600"
          height="1067"
        />
        <figcaption class="meta">
          processo / presença / matéria
        </figcaption>
      </figure>
    </header>

    <section class="service-intro section-shell">
      <p class="meta">A proposta</p>
      <div class="service-intro__text">
        {service.introduction.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="hand-note">olhar de novo →</p>
    </section>

    <section class="service-offers section-shell section-shell--dark">
      <div class="section-heading">
        <p class="meta">Formas de trabalhar</p>
        <h2>O que pode entrar no projeto</h2>
      </div>
      <div class="offer-grid">
        {service.offers.map((offer, index) => (
          <article class="offer-card">
            <p class="meta">{String(index + 1).padStart(2, "0")}</p>
            <h3>{offer.title}</h3>
            <p>{offer.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="audience section-shell">
      <div class="section-heading">
        <p class="meta">Para quem</p>
        <h2>Projetos de escalas e contextos diferentes</h2>
      </div>
      <ul class="audience__list">
        {service.forWhom.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="process section-shell section-shell--night">
      <div class="section-heading">
        <p class="meta">Como funciona</p>
        <h2>Estrutura suficiente para o processo respirar</h2>
      </div>
      <ol class="process__grid">
        {service.process.map((step) => (
          <li>
            <span class="process__number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    {related && (
      <aside class="related-article section-shell">
        <p class="meta">Para preparar sua conversa</p>
        <h2>{related.title}</h2>
        <p>{related.description}</p>
        <a class="text-link" href={`/blog/${related.slug}/`}>
          Ler o artigo <span aria-hidden="true">→</span>
        </a>
      </aside>
    )}

    <Faq items={service.faq} />

    <ContactCTA
      title={`Vamos conversar sobre ${service.navLabel.toLowerCase()}?`}
      text="Conte a data, a cidade, o contexto e o que você precisa fazer circular. A partir disso, organizamos o próximo passo."
    />
  </article>
</BaseLayout>
