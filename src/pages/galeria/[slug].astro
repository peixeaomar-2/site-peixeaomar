---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { galleryProjects } from "../../data/galeria";
import { publicConfig } from "../../config";

export function getStaticPaths() {
  return galleryProjects
    .filter((project) => project.visible)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project }
    }));
}

const { project } = Astro.props;
const canonicalPath = `/galeria/${project.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: project.title,
  description: project.description,
  url: new URL(canonicalPath, publicConfig.siteUrl).toString()
};
---

<BaseLayout
  title={`${project.title} — Galeria`}
  description={project.description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <article class="project-page">
    <header class="portfolio-hero">
      <div>
        <a class="text-link" href="/galeria/">
          <span aria-hidden="true">←</span> Voltar para a galeria
        </a>
        <p class="meta">{project.category}</p>
        <h1>{project.title}</h1>
      </div>
      <p>{project.description}</p>
    </header>

    <section class="project-grid" aria-label={`Fotos de ${project.title}`}>
      {project.photos.map((photo, index) => (
        <figure
          class="project-grid__item"
          data-reveal
          style={`--reveal-delay: ${index * 60}ms`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            width="1600"
            height="1067"
            loading="lazy"
          />
        </figure>
      ))}
    </section>

    <ContactCTA
      eyebrow="Gostou desse álbum?"
      title="Podemos criar algo parecido para o seu projeto."
      tone="plum"
    />
  </article>
</BaseLayout>
