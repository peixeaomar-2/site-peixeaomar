---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Faq from "../components/Faq.astro";
import {
  defaultDescription,
  fourAxes,
  homeFaq,
  posts,
  services
} from "../data/site";
import { publicConfig } from "../config";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "Peixeaomar",
    description: defaultDescription,
    url: publicConfig.siteUrl,
    image: new URL("/og.png", publicConfig.siteUrl).toString(),
    areaServed: {
      "@type": "City",
      name: "Rio de Janeiro"
    },
    knowsAbout: [
      "Fotografia",
      "Produção audiovisual",
      "Aquarela",
      "Educação artística",
      "Projetos culturais"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Peixeaomar",
    url: publicConfig.siteUrl,
    inLanguage: "pt-BR"
  }
];
---

<BaseLayout
  title="Peixeaomar"
  description={defaultDescription}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="meta">Fotografia / arte / educação / cultura</p>
      <h1>Formas de olhar. Processos que ficam.</h1>
      <p class="home-hero__lead">
        A Peixeaomar cria imagens, experiências e processos educativos que
        ampliam percepção, autoria e imaginação.
      </p>
      <div class="button-row">
        <a class="button button--magenta" href="/contato/">
          Pedir um orçamento <span aria-hidden="true">→</span>
        </a>
        <a class="button button--ghost" href="/portfolio/">
          Conhecer os trabalhos
        </a>
      </div>
    </div>
    <div class="home-hero__visual">
      <img
        class="home-hero__photo"
        src="/images/processo-editorial.webp"
        alt="Mãos organizam fotografias e materiais de pintura sobre uma mesa de trabalho"
        width="1600"
        height="1067"
      />
      <img
        class="home-hero__texture"
        src="/images/mare-em-atrito.webp"
        alt=""
        width="1600"
        height="900"
        aria-hidden="true"
      />
      <p class="hand-note home-hero__note">a marca do gesto fica na imagem</p>
    </div>
  </section>

  <section class="axes section-shell">
    <div class="section-heading section-heading--wide">
      <p class="meta">Um mesmo eixo / muitas práticas</p>
      <h2>Produzir e ensinar modos autorais de olhar.</h2>
      <p>
        A unidade não vem de transformar tudo no mesmo serviço. Vem da escuta,
        da curiosidade e da atenção ao processo.
      </p>
    </div>
    <div class="axes__grid">
      {fourAxes.map((axis) => (
        <article class:list={["axis-card", `axis-card--${axis.tone}`]}>
          <p class="meta">{axis.number}</p>
          <h3>{axis.title}</h3>
          <p>{axis.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-services section-shell section-shell--dark">
    <div class="section-heading">
      <p class="meta">Serviços</p>
      <h2>O que seu projeto precisa fazer existir?</h2>
    </div>
    <div class="home-services__list">
      {services.map((service) => (
        <a class="service-row" href={`/${service.slug}/`}>
          <span class="service-row__number meta">{service.number}</span>
          <span class="service-row__title">{service.navLabel}</span>
          <span class="service-row__summary">{service.summary}</span>
          <span class="service-row__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="feature section-shell">
    <figure class="feature__image">
      <img
        src="/images/oficina-editorial.webp"
        alt="Participantes trabalham em conjunto com pincéis, papéis e tinta durante uma oficina"
        width="1600"
        height="1067"
      />
    </figure>
    <div class="feature__copy">
      <p class="meta">Presença sem ameaça</p>
      <h2>Intensa e humana. Direta e acessível.</h2>
      <p>
        O trabalho conversa no mesmo nível de quem participa, nomeia processo,
        dúvida e tentativa, e explica sem simplificar as pessoas.
      </p>
      <a class="text-link" href="/sobre/">
        Conhecer a Peixeaomar <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-process section-shell section-shell--night">
    <div class="section-heading">
      <p class="meta">Começar sem ruído</p>
      <h2>Da primeira mensagem à entrega</h2>
    </div>
    <ol class="home-process__steps">
      <li>
        <span class="meta">01 / conversa</span>
        <h3>Contexto antes de solução</h3>
        <p>Você conta o que precisa, para quem, onde e quando.</p>
      </li>
      <li>
        <span class="meta">02 / proposta</span>
        <h3>Escopo visível</h3>
        <p>Objetivo, entregas, prazo e investimento ficam registrados.</p>
      </li>
      <li>
        <span class="meta">03 / processo</span>
        <h3>Estrutura com abertura</h3>
        <p>O plano orienta o trabalho sem bloquear o que a experiência revela.</p>
      </li>
      <li>
        <span class="meta">04 / continuidade</span>
        <h3>Entrega que circula</h3>
        <p>O material chega organizado para cumprir os usos combinados.</p>
      </li>
    </ol>
  </section>

  <section class="home-blog section-shell">
    <div class="section-heading section-heading--wide">
      <p class="meta">Caderno / repertório / processo</p>
      <h2>Conteúdo para escolher e contratar com mais clareza.</h2>
    </div>
    <div class="post-grid">
      {posts.map((post, index) => (
        <article class="post-card">
          <div class="post-card__meta meta">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{post.category}</span>
          </div>
          <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
          <p>{post.description}</p>
          <a class="text-link" href={`/blog/${post.slug}/`}>
            Ler artigo <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <Faq items={homeFaq} />

  <ContactCTA />
</BaseLayout>
