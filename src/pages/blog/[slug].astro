---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { posts, type BlogPost } from "../../data/site";
import { publicConfig } from "../../config";

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const currentIndex = posts.findIndex((item) => item.slug === post.slug);
const nextPost = posts[(currentIndex + 1) % posts.length];
const canonicalPath = `/blog/${post.slug}/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    dateModified: post.date,
    inLanguage: "pt-BR",
    mainEntityOfPage: new URL(canonicalPath, publicConfig.siteUrl).toString(),
    author: {
      "@type": "Person",
      name: "Mariana"
    },
    publisher: {
      "@type": "Organization",
      name: "Peixeaomar",
      logo: {
        "@type": "ImageObject",
        url: new URL(
          "/images/peixeaomar-logo-branca.png",
          publicConfig.siteUrl
        ).toString()
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: publicConfig.siteUrl
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: new URL("/blog/", publicConfig.siteUrl).toString()
      },
      {
        "@type": "ListItem",
        position: 3,
        name: post.title,
        item: new URL(canonicalPath, publicConfig.siteUrl).toString()
      }
    ]
  }
];
---

<BaseLayout
  title={post.seoTitle}
  description={post.description}
  canonicalPath={canonicalPath}
  type="article"
  jsonLd={jsonLd}
>
  <article class="article-page">
    <header class="article-header">
      <a class="meta article-header__back" href="/blog/">← Voltar ao caderno</a>
      <p class="meta">
        {post.category} / {post.dateLabel} / {post.readingTime}
      </p>
      <h1>{post.title}</h1>
      <p class="article-header__intro">{post.intro}</p>
    </header>

    <div class="article-body">
      <aside class="article-body__aside">
        <p class="hand-note">olha de novo →</p>
        <p class="meta">Peixeaomar / processo / {post.dateLabel}</p>
      </aside>

      <div class="prose article-body__content">
        {post.blocks.map((block) => {
          if (block.type === "heading") return <h2>{block.text}</h2>;
          if (block.type === "paragraph") return <p>{block.text}</p>;
          if (block.type === "quote")
            return <blockquote><p>{block.text}</p></blockquote>;
          if (block.type === "list")
            return <ul>{block.items.map((item) => <li>{item}</li>)}</ul>;
          return null;
        })}
      </div>
    </div>

    <aside class="next-article section-shell">
      <p class="meta">Continue lendo</p>
      <h2><a href={`/blog/${nextPost.slug}/`}>{nextPost.title}</a></h2>
      <a class="text-link" href={`/blog/${nextPost.slug}/`}>
        Abrir próximo artigo <span aria-hidden="true">→</span>
      </a>
    </aside>

    <ContactCTA
      eyebrow="Precisa aplicar isso a um projeto?"
      title="A conversa pode começar pela dúvida."
      text="Conte o contexto e a Peixeaomar ajuda a transformar a necessidade em um escopo possível."
      tone="plum"
    />
  </article>
</BaseLayout>
