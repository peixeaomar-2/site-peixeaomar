---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { posts } from "../../data/site";
---

<BaseLayout
  title="Blog sobre fotografia, arte, educação e projetos culturais"
  description="Guias e textos da Peixeaomar sobre fotografia, audiovisual, aquarela, educação, cultura visual e processos criativos."
  canonicalPath="/blog/"
>
  <article class="blog-index">
    <header class="blog-hero">
      <div>
        <p class="meta">Caderno / repertório / processo</p>
        <h1>Perguntas para ver, escolher e fazer de outro jeito.</h1>
      </div>
      <p>
        Textos para quem quer contratar com clareza, planejar experiências
        visuais e entender o que existe por trás de uma imagem ou oficina.
      </p>
    </header>

    <section class="blog-list section-shell">
      {posts.map((post, index) => (
        <article class="blog-list__item">
          <div class="blog-list__number meta">
            {String(index + 1).padStart(2, "0")}
          </div>
          <div class="blog-list__copy">
            <p class="meta">
              {post.category} / {post.readingTime}
            </p>
            <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.description}</p>
          </div>
          <a
            class="blog-list__arrow"
            href={`/blog/${post.slug}/`}
            aria-label={`Ler: ${post.title}`}
          >
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </section>

    <section class="newsletter-note section-shell section-shell--night">
      <div>
        <p class="meta">Próxima camada</p>
        <h2>O blog já está preparado para crescer.</h2>
      </div>
      <p>
        Novos artigos poderão ser publicados sem mudar a estrutura. Uma
        newsletter gratuita também pode ser conectada depois, quando houver
        uma rotina de conteúdo.
      </p>
    </section>

    <ContactCTA
      eyebrow="Leu e ficou com uma pergunta?"
      title="Conte o contexto do seu projeto."
      text="A primeira conversa serve para organizar necessidades, possibilidades e próximos passos."
    />
  </article>
</BaseLayout>
